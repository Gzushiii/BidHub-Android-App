<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DESIGN SYSTEM THEME -->
    <!-- Base application theme using Material Design 3 -->
    <style name="Base.Theme.BidHub" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorSecondaryVariant">@color/secondaryVariant</item>
        
        <!-- Tertiary color -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>
        <item name="colorTertiaryContainer">@color/tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/on_tertiary_container</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        
        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        
        <!-- Error color -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        
        <!-- Outline colors -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>
        
        <!-- Surface tint -->
        <item name="colorSurfaceTint">@color/surface_tint</item>
    </style>

    <style name="Theme.BidHub" parent="Base.Theme.BidHub">
        <!-- Activity Transitions - Temporarily disabled for debugging -->
        <!-- <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowSharedElementEnterTransition">@transition/slide_transition</item>
        <item name="android:windowSharedElementExitTransition">@transition/slide_transition</item>
        <item name="android:windowEnterTransition">@anim/slide_in_right</item>
        <item name="android:windowExitTransition">@anim/slide_out_left</item> -->
    </style>
    
    <!-- Custom button styles -->
    <style name="BidHubButton" parent="Widget.BidHub.Button.Primary">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.BidHub.Button</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BidHubButtonSecondary" parent="Widget.BidHub.Button.Secondary">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.BidHub.Button</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Enhanced text input styles for forms -->
    <style name="Widget.BidHub.TextInputLayout.OutlinedBox" parent="Widget.BidHub.TextInputLayout">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColorFocused">@color/primary</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="errorTextColor">@color/error</item>
        <item name="android:minHeight">56dp</item>
    </style>
    
    <!-- Legacy text input styles -->
    <style name="BidHubTextInput" parent="Widget.BidHub.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/outline</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
    
    <!-- Legacy card styles -->
    <style name="BidHubCard" parent="Widget.BidHub.Card">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>
    
    <!-- Dialog theme -->
    <style name="DialogTheme" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowElevation">8dp</item>
        <item name="cornerRadius">16dp</item>
    </style>
    
    <!-- Bottom Navigation Active Indicator -->
    <style name="ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:width">64dp</item>
        <item name="android:height">32dp</item>
        <item name="android:background">@drawable/active_indicator_background</item>
        <item name="cornerRadius">16dp</item>
    </style>
</resources>
