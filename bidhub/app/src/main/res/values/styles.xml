<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text Appearance Styles -->
    <style name="TextAppearance.BidHub.LargeTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    
    <style name="TextAppearance.BidHub.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>
    
    <style name="TextAppearance.BidHub.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="TextAppearance.BidHub.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>
    
    <style name="TextAppearance.BidHub.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <style name="TextAppearance.BidHub.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <!-- Bid-Specific Typography -->
    <style name="TextAppearance.BidHub.BidAmount" parent="TextAppearance.BidHub.Headline">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bid_green</item>
    </style>
    
    <style name="TextAppearance.BidHub.CreditBalance" parent="TextAppearance.BidHub.Headline">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/credit_gold</item>
    </style>
    
    <style name="TextAppearance.BidHub.CountdownTimer" parent="TextAppearance.BidHub.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ending_orange</item>
    </style>
    
    <style name="TextAppearance.BidHub.Alias" parent="TextAppearance.BidHub.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    
    <!-- Button Styles -->
    <style name="Widget.BidHub.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height_medium</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">@dimen/button_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/button_padding_vertical</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>
    
    <style name="Widget.BidHub.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">@dimen/button_height_medium</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:paddingHorizontal">@dimen/button_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/button_padding_vertical</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>
    
    <style name="Widget.BidHub.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">@dimen/button_height_medium</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingHorizontal">@dimen/button_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/button_padding_vertical</item>
    </style>
    
    <style name="Widget.BidHub.Button.Success" parent="Widget.BidHub.Button.Primary">
        <item name="android:backgroundTint">@color/semantic_success</item>
    </style>
    
    <style name="Widget.BidHub.Button.Warning" parent="Widget.BidHub.Button.Primary">
        <item name="android:backgroundTint">@color/semantic_warning</item>
    </style>
    
    <style name="Widget.BidHub.Button.Danger" parent="Widget.BidHub.Button.Primary">
        <item name="android:backgroundTint">@color/semantic_error</item>
    </style>
    
    <!-- Card Styles -->
    <style name="Widget.BidHub.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius_medium</item>
        <item name="cardElevation">@dimen/card_elevation_small</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
        <item name="android:layout_margin">@dimen/component_margin_small</item>
    </style>
    
    <style name="Widget.BidHub.Card.Item" parent="Widget.BidHub.Card">
        <item name="android:layout_margin">@dimen/component_margin_small</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius_medium</item>
    </style>
    
    <style name="Widget.BidHub.Card.Bid" parent="Widget.BidHub.Card">
        <item name="android:layout_margin">@dimen/component_margin_small</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius_small</item>
    </style>
    
    <style name="Widget.BidHub.Card.Credit" parent="Widget.BidHub.Card">
        <item name="android:layout_margin">@dimen/component_margin_small</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius_small</item>
    </style>
    
    <!-- Input Field Styles -->
    <style name="Widget.BidHub.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxStrokeColor">@color/border_light</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
    
    <style name="Widget.BidHub.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingHorizontal">@dimen/input_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/input_padding_vertical</item>
    </style>
    
    <!-- Chip Styles -->
    <style name="Widget.BidHub.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeColor">@color/border_light</item>
        <item name="chipBackgroundColor">@color/surface_light</item>
    </style>
    
    <style name="Widget.BidHub.Chip.Choice" parent="Widget.Material3.Chip.Assist">
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipBackgroundColor">@color/primary</item>
    </style>
    
    <!-- Progress Bar Styles -->
    <style name="Widget.BidHub.ProgressBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="android:layout_height">@dimen/progress_bar_height</item>
        <item name="indicatorColor">@color/primary</item>
        <item name="trackColor">@color/gray_200</item>
    </style>
    
    <style name="Widget.BidHub.ProgressBar.Large" parent="Widget.BidHub.ProgressBar">
        <item name="android:layout_height">@dimen/progress_bar_height_large</item>
    </style>
    
    <!-- Badge Styles -->
    <style name="Widget.BidHub.Badge" parent="android:Widget">
        <item name="android:layout_width">@dimen/badge_size</item>
        <item name="android:layout_height">@dimen/badge_size</item>
        <item name="android:background">@color/semantic_error</item>
        <item name="android:textColor">@color/white</item>
    </style>
    
    <!-- List Item Styles -->
    <style name="Widget.BidHub.ListItem" parent="android:Widget">
        <item name="android:minHeight">@dimen/list_item_height_medium</item>
        <item name="android:paddingHorizontal">@dimen/component_padding_medium</item>
        <item name="android:paddingVertical">@dimen/component_padding_small</item>
    </style>
    
    <!-- Divider Styles -->
    <style name="Widget.BidHub.Divider" parent="android:Widget">
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:background">@color/gray_200</item>
        <item name="android:layout_marginHorizontal">@dimen/divider_margin_horizontal</item>
    </style>
    
    <!-- Auction Timer Styles -->
    <style name="Widget.BidHub.AuctionTimer" parent="TextAppearance.BidHub.Body">
        <item name="android:textSize">@dimen/timer_text_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ending_orange</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/timer_height</item>
    </style>
    
    <!-- Loading State Styles -->
    <style name="Widget.BidHub.Shimmer" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius_medium</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/gray_100</item>
    </style>
</resources>
