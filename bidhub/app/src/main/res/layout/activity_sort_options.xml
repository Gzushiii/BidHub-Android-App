<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/background"
        android:elevation="4dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/card_background"
                android:backgroundTint="@color/primary_light"
                android:contentDescription="Back"
                android:padding="12dp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sort Options"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btn_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apply"
                android:textColor="@color/background"
                android:background="@drawable/button_primary"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Sort Options Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sort By"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="16dp" />

                    <RadioGroup
                        android:id="@+id/radio_group_sort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radio_newest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Newest First"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp"
                            android:padding="8dp" />

                        <RadioButton
                            android:id="@+id/radio_oldest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Oldest First"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp"
                            android:padding="8dp" />

                        <RadioButton
                            android:id="@+id/radio_price_low"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price: Low to High"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp"
                            android:padding="8dp" />

                        <RadioButton
                            android:id="@+id/radio_price_high"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price: High to Low"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp"
                            android:padding="8dp" />

                        <RadioButton
                            android:id="@+id/radio_ending_soon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ending Soon"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp"
                            android:padding="8dp" />

                        <RadioButton
                            android:id="@+id/radio_most_popular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Most Popular"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp"
                            android:padding="8dp" />

                        <RadioButton
                            android:id="@+id/radio_most_bids"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Most Bids"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="12dp"
                            android:padding="8dp" />

                        <RadioButton
                            android:id="@+id/radio_alphabetical"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alphabetical (A-Z)"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"
                            android:padding="8dp" />

                    </RadioGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

