<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Package Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/package_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Package Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/package_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POPULAR"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/background"
                android:background="@drawable/badge_background"
                android:padding="6dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Package Description -->
        <TextView
            android:id="@+id/package_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Package description"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <!-- Credits and Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Credits"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/package_credits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱100.00"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_color" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/package_original_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱120.00"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginEnd="8dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/package_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₱100.00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Discount Badge -->
        <TextView
            android:id="@+id/package_discount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save 20%"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/success_color"
            android:background="@drawable/discount_background"
            android:padding="4dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Purchase Button -->
        <Button
            android:id="@+id/btn_purchase"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Purchase Now"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/background"
            android:background="@drawable/button_primary"
            android:stateListAnimator="@null" />

    </LinearLayout>

</androidx.cardview.widget.CardView>

