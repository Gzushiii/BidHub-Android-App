<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="@dimen/spacing_6">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Place Your Bid"
        android:textAppearance="@style/TextAppearance.Title"
        android:layout_marginBottom="@dimen/spacing_2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose your bid amount or enter a custom amount"
        android:textAppearance="@style/TextAppearance.Body"
        android:layout_marginBottom="@dimen/spacing_6" />

    <!-- Current Bid Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/state_hover"
        android:padding="@dimen/spacing_4"
        android:layout_marginBottom="@dimen/spacing_6">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Bid"
                android:textAppearance="@style/TextAppearance.Caption" />

            <TextView
                android:id="@+id/tv_current_bid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textAppearance="@style/TextAppearance.Price.Large" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Credits"
                android:textAppearance="@style/TextAppearance.Caption" />

            <TextView
                android:id="@+id/tv_credit_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120 Credits"
                android:textAppearance="@style/TextAppearance.Price" />

        </LinearLayout>

    </LinearLayout>

    <!-- Suggested Minimum Bid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_4">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Suggested minimum bid:"
            android:textAppearance="@style/TextAppearance.Body" />

        <TextView
            android:id="@+id/tv_suggested_bid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱850.00"
            android:textAppearance="@style/TextAppearance.Price"
            android:textColor="@color/success" />

    </LinearLayout>

    <!-- Quick Bid Buttons -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quick Bid"
        android:textAppearance="@style/TextAppearance.Label"
        android:layout_marginBottom="@dimen/spacing_2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/spacing_4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_bid_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+₱5"
            android:textAppearance="@style/TextAppearance.Button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginEnd="@dimen/spacing_1"
            app:cornerRadius="@dimen/button_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_bid_10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+₱10"
            android:textAppearance="@style/TextAppearance.Button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginHorizontal="@dimen/spacing_1"
            app:cornerRadius="@dimen/button_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_bid_20"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+₱20"
            android:textAppearance="@style/TextAppearance.Button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginHorizontal="@dimen/spacing_1"
            app:cornerRadius="@dimen/button_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_bid_50"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+₱50"
            android:textAppearance="@style/TextAppearance.Button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginStart="@dimen/spacing_1"
            app:cornerRadius="@dimen/button_corner_radius" />

    </LinearLayout>

    <!-- Custom Bid Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom Amount"
        android:textAppearance="@style/TextAppearance.Label"
        android:layout_marginBottom="@dimen/spacing_2" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter bid amount"
        style="@style/Widget.BidHub.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="@dimen/spacing_6">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_custom_bid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textAppearance="@style/TextAppearance.Body" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Bid Summary -->
    <LinearLayout
        android:id="@+id/layout_bid_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/state_hover"
        android:padding="@dimen/spacing_4"
        android:layout_marginBottom="@dimen/spacing_6"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_2">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Your Bid"
                android:textAppearance="@style/TextAppearance.Body" />

            <TextView
                android:id="@+id/tv_your_bid_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:textAppearance="@style/TextAppearance.Price" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_2">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Credit Cost"
                android:textAppearance="@style/TextAppearance.Body" />

            <TextView
                android:id="@+id/tv_credit_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 Credits"
                android:textAppearance="@style/TextAppearance.Body" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Remaining Balance"
                android:textAppearance="@style/TextAppearance.Body" />

            <TextView
                android:id="@+id/tv_remaining_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="110 Credits"
                android:textAppearance="@style/TextAppearance.Body" />

        </LinearLayout>

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_bid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textAppearance="@style/TextAppearance.Button.Secondary"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginEnd="@dimen/spacing_4"
            app:cornerRadius="@dimen/button_corner_radius" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_bid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Place Bid"
            android:textAppearance="@style/TextAppearance.Button"
            style="@style/Widget.Material3.Button"
            app:cornerRadius="@dimen/button_corner_radius" />

    </LinearLayout>

</LinearLayout>
