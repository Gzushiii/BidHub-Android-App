<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:contentScrim="@color/surface"
            app:expandedTitleTextAppearance="@style/TextAppearance.BidHub.LargeTitle"
            app:collapsedTitleTextAppearance="@style/TextAppearance.BidHub.Headline"
            app:scrimAnimationDuration="300"
            app:expandedTitleMarginStart="@dimen/spacing_4"
            app:expandedTitleMarginBottom="@dimen/spacing_4">

            <!-- Image Gallery with ViewPager2 -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewpager_images"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface_variant" />

            <!-- Image Indicators -->
            <LinearLayout
                android:id="@+id/layout_image_indicators"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/spacing_4"
                android:background="@drawable/rounded_background"
                android:backgroundTint="#80000000"
                android:paddingHorizontal="@dimen/spacing_2"
                android:paddingVertical="@dimen/spacing_1" />

            <!-- Toolbar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                app:layout_collapseMode="pin">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:tint="@color/text_white" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_share"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/share"
                    android:tint="@color/text_white"
                    android:layout_marginEnd="@dimen/spacing_1" />

                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_favorite_border"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/add_to_favorites"
                    android:tint="@color/text_white" />

            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_4">

            <!-- Item Title and Category -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/section_spacing">

                <TextView
                    android:id="@+id/tv_item_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BidHub.LargeTitle"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/spacing_1"
                    tools:text="Luxury Watch Collection" />

                <TextView
                    android:id="@+id/tv_item_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BidHub.Caption"
                    android:textColor="@color/text_secondary"
                    tools:text="Watches · New" />

            </LinearLayout>

            <!-- Price Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/section_spacing"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_4">

                    <!-- Bid Info Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_4">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.BidHub.Caption"
                                android:text="@string/starting_bid"
                                android:textColor="@color/text_secondary"
                                android:layout_marginBottom="@dimen/spacing_1" />

                            <TextView
                                android:id="@+id/tv_starting_bid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.BidHub.Headline"
                                android:textColor="@color/text_primary"
                                tools:text="₱500.00" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/outline_variant"
                            android:layout_marginHorizontal="@dimen/spacing_3" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.BidHub.Caption"
                                android:text="@string/current_bid"
                                android:textColor="@color/text_secondary"
                                android:layout_marginBottom="@dimen/spacing_1" />

                            <TextView
                                android:id="@+id/tv_current_bid"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.BidHub.BidAmount"
                                android:textColor="@color/primary"
                                tools:text="₱750.00" />
                            
                            <TextView
                                android:id="@+id/tv_bid_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.BidHub.Caption"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="@dimen/spacing_1"
                                tools:text="5 bids" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Time Left with Progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="@dimen/spacing_2">

                            <ImageView
                                android:layout_width="@dimen/icon_size_medium"
                                android:layout_height="@dimen/icon_size_medium"
                                android:src="@drawable/ic_timer"
                                android:tint="@color/ending_orange"
                                android:contentDescription="@string/time_left"
                                android:layout_marginEnd="@dimen/spacing_2" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.BidHub.Body"
                                android:textStyle="bold"
                                android:text="@string/time_left"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tv_time_left"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.BidHub.CountdownTimer"
                                android:textColor="@color/ending_orange"
                                tools:text="2d 12h 30m" />

                        </LinearLayout>

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_time_left"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/progress_bar_height_large"
                            android:progress="50"
                            android:max="100"
                            app:indicatorColor="@color/ending_orange"
                            app:trackColor="@color/surface_variant"
                            app:trackCornerRadius="@dimen/progress_bar_corner_radius" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Description Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/section_spacing"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BidHub.Headline"
                        android:text="@string/description"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/spacing_3" />

                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BidHub.Body"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="4dp"
                        tools:text="This luxury watch features a stainless steel case, sapphire crystal, and automatic movement. It's water-resistant up to 100 meters and comes with a certificate of authenticity." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Seller Information -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/section_spacing"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BidHub.Headline"
                        android:text="@string/seller_information"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/spacing_3" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/image_avatar_size_large"
                            android:layout_height="@dimen/image_avatar_size_large"
                            app:cardCornerRadius="@dimen/image_avatar_size_large"
                            app:cardElevation="0dp"
                            app:strokeWidth="2dp"
                            app:strokeColor="@color/outline_variant">

                            <ImageView
                                android:id="@+id/iv_seller_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_person"
                                android:contentDescription="@string/seller_avatar"
                                android:background="@color/surface_variant" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/spacing_4">

                            <TextView
                                android:id="@+id/tv_seller_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.BidHub.Body"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:layout_marginBottom="@dimen/spacing_1"
                                tools:text="Ethan Carter" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="@dimen/icon_size_small"
                                    android:layout_height="@dimen/icon_size_small"
                                    android:src="@drawable/ic_star"
                                    android:tint="@color/credit_gold"
                                    android:contentDescription="@string/rating"
                                    android:layout_marginEnd="@dimen/spacing_1" />

                                <TextView
                                    android:id="@+id/tv_seller_rating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.BidHub.Caption"
                                    android:textColor="@color/text_secondary"
                                    tools:text="4.8 (125 reviews)" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bid History Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/section_spacing"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.BidHub.Headline"
                        android:text="@string/bid_history"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/spacing_3" />

                    <LinearLayout
                        android:id="@+id/layout_bid_history"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Spacer for bottom action bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:elevation="8dp"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_4"
            android:background="@color/surface">

            <!-- Bid Amount Input - Enhanced Material 3 Design -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_bid_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/enter_your_bid"
                android:layout_marginBottom="@dimen/spacing_4"
                style="@style/Widget.BidHub.TextInputLayout"
                app:prefixText="₱"
                app:prefixTextColor="@color/on_surface"
                app:prefixTextAppearance="@style/TextAppearance.Material3.TitleLarge"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/outline"
                app:boxStrokeWidth="2dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxBackgroundColor="@color/surface_container_high"
                app:hintTextColor="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bid_amount"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:minHeight="64dp"
                    android:inputType="numberDecimal"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:gravity="center_vertical"
                    android:letterSpacing="0.01" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:id="@+id/layout_action_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_place_bid"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:minHeight="56dp"
                    android:layout_weight="1"
                    android:text="@string/place_bid"
                    android:visibility="visible"
                    android:enabled="true"
                    style="@style/Widget.BidHub.Button.Primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="@dimen/spacing_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_buy_now"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:minHeight="56dp"
                    android:layout_weight="1"
                    android:text="@string/buy_now"
                    style="@style/Widget.BidHub.Button.Secondary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="@dimen/spacing_2" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
