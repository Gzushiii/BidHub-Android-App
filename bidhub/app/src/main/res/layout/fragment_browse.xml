<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/background"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse Items"
                    android:textAppearance="@style/TextAppearance.BidHub.H2"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/spacing_1" />

                <TextView
                    android:id="@+id/tv_item_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discover amazing items to bid on"
                    android:textAppearance="@style/TextAppearance.BidHub.Body2"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- View Toggle Button -->
                <ImageButton
                    android:id="@+id/btn_view_toggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_grid_view"
                    android:background="@drawable/card_background"
                    android:backgroundTint="@color/neutral_100"
                    android:tint="@color/text_primary"
                    android:contentDescription="Toggle View"
                    android:padding="@dimen/spacing_3"
                    android:layout_marginEnd="@dimen/spacing_2" />

                <!-- Sort Button -->
                <ImageButton
                    android:id="@+id/btn_sort"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_sort"
                    android:background="@drawable/card_background"
                    android:backgroundTint="@color/neutral_100"
                    android:tint="@color/text_primary"
                    android:contentDescription="Sort Items"
                    android:padding="@dimen/spacing_3"
                    android:layout_marginEnd="@dimen/spacing_2" />


            </LinearLayout>

        </LinearLayout>

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search items..."
            style="@style/Widget.BidHub.TextInputLayout"
            app:startIconDrawable="@drawable/ic_search"
            app:boxBackgroundMode="outline"
            app:hintTextColor="@color/text_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:imeOptions="actionSearch" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Filter Chips Container -->
    <LinearLayout
        android:id="@+id/layout_filter_chips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/spacing_2"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/hsv_filter_chips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/spacing_4">

            <LinearLayout
                android:id="@+id/layout_filter_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Filter chips will be added dynamically -->

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Clear All Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_all_filters"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Clear All"
            style="@style/Widget.BidHub.Button.Text"
            android:textSize="12sp"
            android:textColor="@color/primary"
            android:minHeight="32dp"
            android:minWidth="60dp"
            android:paddingHorizontal="@dimen/spacing_3"
            android:layout_marginEnd="@dimen/spacing_4"
            android:layout_gravity="center_vertical" />

    </LinearLayout>

    <!-- Content Area with SwipeRefreshLayout -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Items RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_items"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/spacing_2"
                android:clipToPadding="false" />

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_8"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_empty_icon"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_search"
                    android:alpha="0.2"
                    android:layout_marginBottom="@dimen/spacing_6"
                    android:contentDescription="No items found" />

            <TextView
                android:id="@+id/tv_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No items found"
                android:textAppearance="@style/TextAppearance.BidHub.H3"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/spacing_3" />

                <TextView
                    android:id="@+id/tv_empty_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We couldn't find any items matching your search"
                    android:textAppearance="@style/TextAppearance.BidHub.Body2"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/spacing_2" />

                <TextView
                    android:id="@+id/tv_empty_suggestions_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Try these suggestions:"
                    android:textAppearance="@style/TextAppearance.BidHub.Body1"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/spacing_4"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layout_empty_suggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Broaden your search terms"
                        android:textAppearance="@style/TextAppearance.BidHub.Body2"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="@dimen/spacing_1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Remove some filters"
                        android:textAppearance="@style/TextAppearance.BidHub.Body2"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="@dimen/spacing_1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Check your spelling"
                        android:textAppearance="@style/TextAppearance.BidHub.Body2"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="@dimen/spacing_1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Try different keywords"
                        android:textAppearance="@style/TextAppearance.BidHub.Body2"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <!-- Action Buttons for Empty State -->
                <LinearLayout
                    android:id="@+id/layout_empty_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_search"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear Search"
                        style="@style/Widget.BidHub.Button.Text"
                        android:layout_marginEnd="@dimen/spacing_4" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_browse_categories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Browse Categories"
                        style="@style/Widget.BidHub.Button.Primary" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
