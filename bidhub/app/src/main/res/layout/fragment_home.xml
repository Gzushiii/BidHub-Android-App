<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/background">

            <!-- Simple Header: Profile, Title, Credits - Material 3 -->
            <LinearLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_4"
                android:paddingEnd="@dimen/spacing_4"
                android:paddingTop="@dimen/spacing_4"
                android:paddingBottom="@dimen/spacing_2"
                android:background="@color/surface">

                <!-- Profile Image (Left) - Material 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/surface_container_high"
                    app:strokeWidth="0dp"
                    android:layout_marginEnd="@dimen/spacing_3">
                    
                    <ImageView
                        android:id="@+id/iv_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/profile"
                        tools:src="@drawable/ic_person" />
                        
                </com.google.android.material.card.MaterialCardView>

                <!-- Title (Center) - Material 3 -->
                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/on_surface"
                    android:gravity="center" />

                <!-- Credits (Right) - Material 3 -->
                <TextView
                    android:id="@+id/tv_header_credits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1200"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface_variant"
                    android:minWidth="48dp"
                    android:gravity="end" />

            </LinearLayout>

            <!-- Featured Auctions Section - Material 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/featured_auctions"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/on_surface"
                android:layout_marginStart="@dimen/spacing_4"
                android:layout_marginTop="@dimen/spacing_6"
                android:layout_marginBottom="@dimen/spacing_3" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_featured_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/spacing_2"
                android:paddingEnd="@dimen/spacing_2"
                android:layout_marginBottom="@dimen/spacing_6"
                tools:listitem="@layout/item_card" />

            <!-- Active Auctions Section - Material 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/active_auctions"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/on_surface"
                android:layout_marginStart="@dimen/spacing_4"
                android:layout_marginTop="@dimen/spacing_6"
                android:layout_marginBottom="@dimen/spacing_3" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_active_auctions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/spacing_2"
                android:paddingEnd="@dimen/spacing_2"
                android:layout_marginBottom="@dimen/spacing_6"
                tools:listitem="@layout/item_active_auction" />

            <!-- Your Active Bids Section - Material 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/spacing_4"
                android:layout_marginEnd="@dimen/spacing_4"
                android:layout_marginTop="@dimen/spacing_6"
                android:layout_marginBottom="@dimen/spacing_3">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/your_active_bids"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textColor="@color/on_surface" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_all_bids"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.BidHub.Button.Text"
                    android:text="@string/view_all"
                    android:textSize="14sp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_active_bids"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/spacing_2"
                android:paddingEnd="@dimen/spacing_2"
                android:layout_marginBottom="@dimen/spacing_6"
                tools:listitem="@layout/item_active_bid" />

            <!-- Empty State (initially hidden) -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/ic_image_placeholder"
                    android:tint="@color/text_hint"
                    android:contentDescription="@string/no_items"
                    android:layout_marginBottom="@dimen/spacing_4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BidHub.H3"
                    android:text="@string/no_items_found"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/spacing_2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.BidHub.Body2"
                    android:text="@string/start_browsing_or_posting"
                    android:textColor="@color/text_secondary"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading Indicator - Material 3 -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_loading"
        style="@style/Widget.Material3.CircularProgressIndicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"
        app:indicatorColor="@color/primary"
        app:trackColor="@color/surface_container_high"
        android:contentDescription="@string/loading" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
