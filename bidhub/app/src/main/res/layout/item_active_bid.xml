<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- Left Section: Text Content -->
    <LinearLayout
        android:id="@+id/layout_text_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_item_image"
        app:layout_constraintWidth_percent="0.66">

        <!-- Current Bid -->
        <TextView
            android:id="@+id/tv_current_bid_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_bid_label"
            android:textAppearance="@style/TextAppearance.BidHub.Body2"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_1"
            tools:text="Current Bid:" />

        <TextView
            android:id="@+id/tv_current_bid_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.BidHub.Body2"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_2"
            tools:text="$55" />

        <!-- Item Name -->
        <TextView
            android:id="@+id/item_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.BidHub.Body1"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="@dimen/spacing_1"
            tools:text="Vintage Camera" />

        <!-- Time Left -->
        <TextView
            android:id="@+id/time_remaining_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_left_label"
            android:textAppearance="@style/TextAppearance.BidHub.Body2"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_3"
            tools:text="Time Left: 00h 55m 23s" />

        <!-- Bid Now Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bid_now"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="32dp"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/spacing_4"
            android:text="@string/bid_now"
            android:textAppearance="@style/TextAppearance.BidHub.Button"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/neutral_100"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:drawableEnd="@drawable/ic_arrow_right"
            android:drawablePadding="@dimen/spacing_1"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:cornerRadius="8dp" />

        <!-- Bid Status (optional, for user's bids) -->
        <TextView
            android:id="@+id/bid_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WINNING"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Right Section: Image -->
    <ImageView
        android:id="@+id/iv_item_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:background="@color/surface_variant"
        android:contentDescription="@string/item_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layout_text_content"
        app:layout_constraintWidth_percent="0.33"
        app:layout_constraintDimensionRatio="16:9"
        tools:src="@drawable/ic_image_placeholder" />

</androidx.constraintlayout.widget.ConstraintLayout>
