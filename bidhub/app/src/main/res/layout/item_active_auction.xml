<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.BidHub.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_2"
    android:layout_marginEnd="@dimen/spacing_2"
    android:layout_marginTop="@dimen/spacing_2"
    android:layout_marginBottom="@dimen/spacing_2"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_container">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/spacing_4">

    <!-- Left Section: Text Content -->
    <LinearLayout
        android:id="@+id/layout_text_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_item_image"
        app:layout_constraintWidth_percent="0.66">

        <!-- Current Bid - Material 3 -->
        <TextView
            android:id="@+id/tv_current_bid_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_bid_label"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/on_surface_variant"
            android:layout_marginBottom="@dimen/spacing_1"
            tools:text="Current Bid:" />

        <TextView
            android:id="@+id/tv_current_bid_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="@dimen/spacing_2"
            tools:text="$55" />

        <!-- Item Name - Material 3 -->
        <TextView
            android:id="@+id/tv_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/on_surface"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="@dimen/spacing_1"
            tools:text="Vintage Camera" />

        <!-- Seller and Bid Count Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_1">

            <!-- Seller Info -->
            <TextView
                android:id="@+id/tv_seller_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/on_surface_variant"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="by Seller Name" />

            <!-- Bid Count -->
            <TextView
                android:id="@+id/tv_bid_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/on_surface_variant"
                tools:text="5 bids" />

        </LinearLayout>

        <!-- Time Left - Material 3 -->
        <TextView
            android:id="@+id/tv_time_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/time_left_label"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/on_surface_variant"
            android:layout_marginBottom="@dimen/spacing_3"
            tools:text="Time Left: 00h 55m 23s" />

        <!-- Bid Now Button - Material 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bid_now"
            style="@style/Widget.BidHub.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="36dp"
            android:minWidth="0dp"
            android:text="@string/bid_now"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Right Section: Image -->
    <ImageView
        android:id="@+id/iv_item_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:background="@color/surface_variant"
        android:contentDescription="@string/item_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layout_text_content"
        app:layout_constraintWidth_percent="0.33"
        app:layout_constraintDimensionRatio="16:9"
        tools:src="@drawable/ic_image_placeholder" />

</androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

