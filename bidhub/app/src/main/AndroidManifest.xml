<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BidHub"
        tools:targetApi="31">

        <!--
        This is the new LAUNCHER activity.
        The intent-filter tells Android that this is the first screen to open.
        -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
        MainActivity no longer has the launcher intent-filter.
        It will only be opened from another activity.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- We also need to add RegisterActivity to the manifest -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Password Recovery Activities -->
        <activity
            android:name=".PasswordRecoveryRequestActivity"
            android:exported="false" />
        
        <activity
            android:name=".PasswordRecoveryVerificationActivity"
            android:exported="false" />
        
        <activity
            android:name=".PasswordResetActivity"
            android:exported="false" />
        
        <!-- Test Activity (can be removed in production) -->
        <activity
            android:name=".PasswordRecoveryTestActivity"
            android:exported="false" />

        <!-- Bottom Navigation Activities -->
        <activity
            android:name=".BrowseActivity"
            android:exported="false" />
        
        <activity
            android:name=".PostActivity"
            android:exported="false" />
        
        <activity
            android:name=".CreditsActivity"
            android:exported="false" />
        
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />
        
        <activity
            android:name=".ItemDetailActivity"
            android:exported="false" />

        <activity
            android:name=".MyListingsActivity"
            android:exported="false" />

        <!-- Profile Management Activities -->
        <activity
            android:name=".ProfileEditActivity"
            android:exported="false" />
        
        <activity
            android:name=".ProfileSettingsActivity"
            android:exported="false" />
        
        <activity
            android:name=".ChangePasswordActivity"
            android:exported="false" />
        
        <activity
            android:name=".PrivacySettingsActivity"
            android:exported="false" />
        
        <activity
            android:name=".AccountSecurityActivity"
            android:exported="false" />
        
        <!-- Bidding System Activities -->
        <activity
            android:name=".BidConfirmationActivity"
            android:exported="false" />
        
        <activity
            android:name=".BidHistoryActivity"
            android:exported="false" />
        
        <activity
            android:name=".ActiveBidsActivity"
            android:exported="false" />
        
        <activity
            android:name=".WonAuctionsActivity"
            android:exported="false" />
        
        <activity
            android:name=".LostAuctionsActivity"
            android:exported="false" />
        
        <activity
            android:name=".AuctionCountdownActivity"
            android:exported="false" />

    </application>

</manifest>

